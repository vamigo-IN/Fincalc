# FinCalc API — environment.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way. It holds the peppers and the signing
# key; leaking them is a full authentication compromise.
#
# ── HOW TO READ THIS FILE ────────────────────────────────────────────────────
#
# Every field is tagged, because the same .env feeds two different consumers and
# not every field reaches both:
#
#   [REQUIRED]  No default. The stack refuses to start without it.
#   [LOCAL]     Only used by `npm run dev` / `npm test`, which run on your
#               machine. UNDER DOCKER THESE ARE IGNORED — compose builds them
#               from the service names and POSTGRES_PASSWORD instead, so editing
#               them here changes nothing in a container. Left in because
#               non-Docker development genuinely needs them.
#   [OPTIONAL]  Has a working default in src/config.ts. Set it only to change
#               that default. The commented value IS the default.
#
# Defaults live in src/config.ts and nowhere else. docker-compose.yml passes
# optional fields through as `${VAR:-}` and config.ts treats an empty value as
# unset, so a blank line here means "use the default" rather than "use empty".
#
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. SECRETS — set these four before the first deploy ═════════════════════

# [REQUIRED] Postgres superuser password. Compose builds DATABASE_URL from it,
# so this one value covers both the database and the API's connection string.
# Generate:  openssl rand -base64 36 | tr -d '/+='
POSTGRES_PASSWORD=

# [REQUIRED] HMAC'd into every password before bcrypt, so a stolen database
# backup alone cannot crack the hashes.
#
# ROTATING THIS INVALIDATES EVERY EXISTING PASSWORD — every user is locked out
# permanently, with no reset path. Treat it as permanent and back it up wherever
# you back up the database.
# Generate:  openssl rand -base64 48
PASSWORD_PEPPER=

# [REQUIRED] Hashes user ids in the audit log, so the log is not itself a lookup
# table of who did what. Safe to rotate; old rows simply stop correlating.
# Generate:  openssl rand -base64 48
AUDIT_PEPPER=

# [REQUIRED] Ed25519 signing keys: a JSON OBJECT mapping kid -> base64 of a
# PKCS8 PEM. One line, braces and quotes exactly as shown.
#
#   JWT_SIGNING_KEYS={"k1":"LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t…"}
#
# NOT a JWK array. An earlier version of this comment said it was; that value
# parses as JSON and then crashes the API. It is validated at boot now, so a
# wrong shape is a readable error rather than a crash loop.
#
# Generate (openssl only — nothing else needed):
#   echo "JWT_SIGNING_KEYS={\"k1\":\"$(openssl genpkey -algorithm ed25519 | base64 -w0)\"}"
#
# Rotation: add the new key ALONGSIDE the old with `npm run keygen -- --add k2`,
# switch JWT_CURRENT_KID, and drop the old kid only after every token signed
# with it has expired (REFRESH_TOKEN_TTL_S). Removing it early signs everyone out.
JWT_SIGNING_KEYS=


# ═══ 2. ADMIN ACCOUNT ════════════════════════════════════════════════════════

# Comma-separated emails granted the admin claim. Without at least one, the
# admin dashboard has no account that can reach it.
ADMIN_EMAILS=admin@vamigo.in

# Password for the seeded admin, applied ONLY when the account does not yet
# exist — a redeploy never resets an existing admin's password.
#
# Leave blank in production and create the account explicitly instead:
#   docker compose exec fincalc_api node dist/scripts/reset-admin.js
# A password set here is a password in your shell history and in the deploy log.
# Minimum 12 characters.
ADMIN_PASSWORD=

# [OPTIONAL] Which admin reset-admin.js targets when several are listed above.
# Defaults to the first ADMIN_EMAILS entry.
#ADMIN_EMAIL=


# ═══ 3. LOCAL DEVELOPMENT ONLY — ignored under Docker ════════════════════════
#
# Compose hardcodes all four: DATABASE_URL and REDIS_URL point at the internal
# service names (fincalc_postgres / fincalc_redis), PORT is fixed at 8087, and
# NODE_ENV is pinned to production so a stray line here can never turn off
# fail-fast on a live box. Setting them below affects `npm run dev` only.

# [LOCAL] Host ports 5442/6389 — never the VPS's occupied 5432/5433/6379.
DATABASE_URL=postgresql://fincalc_owner:fincalc_dev_only@localhost:5442/fincalc?schema=public
REDIS_URL=redis://localhost:6389

# [LOCAL] development | test | production
NODE_ENV=development

# [LOCAL] 8087. The blocked set (5432, 5433, 3050, 3000, 5050, 6379, 5678) is
# rejected at boot — those belong to other projects on the VPS.
PORT=8087


# ═══ 4. TOKENS AND SESSIONS ══════════════════════════════════════════════════

# [OPTIONAL] Which kid signs new tokens. The others still verify.
#JWT_CURRENT_KID=k1

# [OPTIONAL] Must match what the app expects, or every token is rejected.
#JWT_ISSUER=https://fincalc.vamigo.in
#JWT_AUDIENCE=fincalc-app

# [OPTIONAL] Access tokens are short-lived because they cannot be revoked;
# revocation happens at refresh. Seconds.
#ACCESS_TOKEN_TTL_S=900
#REFRESH_TOKEN_TTL_S=2592000

# [OPTIONAL] Sessions per user before the oldest is evicted.
#MAX_DEVICES_PER_USER=5


# ═══ 5. SECURITY TUNING ══════════════════════════════════════════════════════

# [OPTIONAL] bcrypt cost. Measured, not guessed: pick the highest value under
# ~250ms on YOUR hardware. bcryptjs is pure JS and ~3x slower than the native
# binding, so 11 here is comparable work to native 12. Login is the endpoint an
# attacker floods — too high is a self-inflicted denial of service.
#BCRYPT_COST=11

# [OPTIONAL] Per-IP request ceilings. The auth bucket is deliberately tight; a
# CI environment registering many throwaway accounts from one IP is the reason
# it is tunable at all. Raising it in production weakens brute-force protection.
#RATE_LIMIT_AUTH_MAX=10
#RATE_LIMIT_WRITE_MAX=120

# [OPTIONAL] Nginx caps bodies at 256k to match; raise both or neither.
#BODY_LIMIT=256kb
#REQUEST_TIMEOUT_MS=15000


# ═══ 6. FEATURES ═════════════════════════════════════════════════════════════

# [OPTIONAL] Goals allowed on the free tier.
#FREE_TIER_GOAL_LIMIT=3

# [OPTIONAL] exchangerate-api.com key. SERVER-SIDE ONLY — this value must never
# ship in the APK. Without it /v1/reference/rates serves from cache or Postgres
# and reports the gap honestly rather than failing.
EXCHANGERATE_API_KEY=

# [OPTIONAL] Base currency, and how long a quote counts as fresh (minutes).
# The free tier allows ~1500 calls/month; 60 minutes is ~720.
#FX_BASE_CURRENCY=INR
#FX_FRESH_MINUTES=60


# ═══ 7. LOGGING ══════════════════════════════════════════════════════════════

# [OPTIONAL] fatal | error | warn | info | debug | trace
# `debug` logs request bodies — never on a box holding real user data.
#LOG_LEVEL=info


# ═══ 8. CONTAINER RESOURCES ══════════════════════════════════════════════════
#
# Read by docker-compose.yml, not by the application. All optional; the defaults
# below suit a 1 vCPU / ~2GB VPS shared with other projects.
#
# CPUS MUST NOT EXCEED THE HOST'S CORE COUNT (`nproc`) or Docker refuses to
# create the container: "range of CPUs is from 0.01 to 1.00, as there are only
# 1 CPUs available". These are CEILINGS, not reservations, so they may sum to
# more than the host has.

#API_CPUS=0.9
#API_MEMORY=384M
#PG_CPUS=0.7
#PG_MEMORY=640M
#REDIS_CPUS=0.3
#REDIS_MEMORY=160M

# Postgres tuning. shared_buffers wants roughly a quarter of what Postgres is
# allowed. effective_cache_size allocates nothing — it is an ESTIMATE of the OS
# page cache, and setting it above what the machine has makes the planner choose
# index scans that then hit disk.
#PG_SHARED_BUFFERS=160MB
#PG_EFFECTIVE_CACHE=384MB
#PG_WORK_MEM=4MB
#PG_MAINTENANCE_WORK_MEM=64MB
#PG_MAX_CONNECTIONS=50

# Redis is a cache: allkeys-lru eviction, so this is a ceiling not a reservation.
#REDIS_MAXMEMORY=96mb

# On a 4 vCPU / 8GB host, roughly:
#   API_CPUS=2  API_MEMORY=1G  PG_CPUS=1.5  PG_MEMORY=2G
#   PG_SHARED_BUFFERS=512MB  PG_EFFECTIVE_CACHE=2GB  PG_MAX_CONNECTIONS=100
