# FinCalc API — copy to .env and fill in.
#
# .env is gitignored. In production it is sops+age encrypted as .env.prod.enc
# and decrypted only on the VPS at deploy time.
#
# EVERY variable config.ts reads appears here. That is the point of the file: a
# template that covers half the settings sends whoever deploys next hunting
# through source for the rest, and the ones most likely to be missed are the
# three the API refuses to start without.

NODE_ENV=development
LOG_LEVEL=debug

# ── Ports ────────────────────────────────────────────────────────────────────
# BLOCKED on the VPS (already in use by other projects):
#   5432, 5433, 3050, 3000, 5050, 6379, 5678
# config.ts REJECTS these at boot rather than letting a collision fail silently.
PORT=8087

# ── Datastores ───────────────────────────────────────────────────────────────
# Host ports 5442 / 6389 map to the containers' standard 5432 / 6379.
DATABASE_URL=postgresql://fincalc_owner:fincalc_dev_only@localhost:5442/fincalc?schema=public
REDIS_URL=redis://localhost:6389

# Used by docker-compose to initialise the postgres container. CHANGE THIS
# before the stack is reachable from anything but localhost.
POSTGRES_PASSWORD=fincalc_dev_only

# ── Secrets: MANDATORY IN PRODUCTION ─────────────────────────────────────────
# config.ts exits at boot if any of these three is missing when
# NODE_ENV=production. That is deliberate — a misconfigured deploy should never
# start and serve traffic, then break at the first login.
#
# Generate each with:
#   openssl rand -base64 48
#
# PASSWORD_PEPPER is mixed into every password hash before bcrypt. ROTATING IT
# INVALIDATES EVERY EXISTING PASSWORD — treat it as permanent.
PASSWORD_PEPPER=
# Hashes identifiers in the audit log so the log itself is not a lookup table.
AUDIT_PEPPER=

# Ed25519 signing keys: a JSON OBJECT mapping kid -> base64 of a PKCS8 PEM.
#   JWT_SIGNING_KEYS={"k1":"LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t…"}
#
# NOT a JWK array — an earlier version of this comment said it was, and that
# value parses as JSON and then crashes the API on boot. It is validated at
# startup now, so a wrong shape is a readable error rather than a crash loop.
#
# Generate one (openssl only — nothing else needed):
#   echo "JWT_SIGNING_KEYS={\"k1\":\"$(openssl genpkey -algorithm ed25519 | base64 -w0)\"}"
#
# Rotation: add the new key ALONGSIDE the old, switch JWT_CURRENT_KID, then drop
# the old kid once every token signed with it has expired (REFRESH_TOKEN_TTL_S).
# `npm run keygen -- --add k2` does this correctly. Removing the old key early
# signs every user out.
#
# Must be one line. Keep the braces and quotes exactly as shown.
JWT_SIGNING_KEYS=
JWT_CURRENT_KID=k1
JWT_ISSUER=https://fincalc.vamigo.in
JWT_AUDIENCE=fincalc-app

# ── Tokens and sessions ──────────────────────────────────────────────────────
# Access tokens are short-lived because they cannot be revoked; refresh tokens
# carry the session and ARE revocable, with reuse detection killing the family.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
MAX_DEVICES_PER_USER=5

# bcrypt work factor. 11 measured at ~150ms on the target VPS; 12 took 317ms,
# over the 250ms budget for a login round trip. Raise it when the hardware does.
BCRYPT_COST=11

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated emails granted the admin claim and access to /admin.
# An account must ALSO exist with this address — the allowlist grants a role, it
# does not create a user. `npx tsx scripts/reset-admin.ts` creates or resets it.
ADMIN_EMAILS=admin@fincalc.local

# Used ONLY by the seed and reset-admin scripts, never at runtime. Leave blank
# in development and one is generated and printed once. In production the seed
# REFUSES to generate: a password that exists only in a deploy log cannot be
# rotated and can be read by anyone with log access.
ADMIN_PASSWORD=

# ── Rate limits (requests per window, per user or IP) ────────────────────────
# Auth is far tighter than writes: it is the endpoint worth brute-forcing.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=120

# ── Product limits ───────────────────────────────────────────────────────────
FREE_TIER_GOAL_LIMIT=3

# ── Currency rates ───────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. This key must never appear in the Flutter app or the APK:
# anything shipped in an APK takes about two minutes to extract, and deleting it
# later does not undo that — it stays in git history and on every installed
# phone. Get a key at exchangerate-api.com.
EXCHANGERATE_API_KEY=

FX_BASE_CURRENCY=INR
# Freshness window in minutes. At most one upstream call per window, and only
# when a user actually asks — a quiet night costs nothing, and the free tier's
# monthly quota is never at risk.
FX_FRESH_MINUTES=60

# ── HTTP ─────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=256kb

# ── Container resources ──────────────────────────────────────────────────────
# Read by docker-compose.yml, not by the app. The defaults suit a SMALL VPS —
# 1 vCPU, ~2GB, shared with whatever else the host already runs — and total
# about 1.2GB of memory ceiling across the three services.
#
# CPU VALUES MUST NOT EXCEED THE HOST'S CORE COUNT. Docker refuses to create the
# container otherwise and the stack will not start:
#   "range of CPUs is from 0.01 to 1.00, as there are only 1 CPUs available"
# Check with: nproc
#
# These are CEILINGS, not reservations, so they may sum to more than the host
# has. Each says "no more than this", not "set this aside".
#
# Defaults (uncomment to override):
# API_CPUS=0.9
# API_MEMORY=384M
# PG_CPUS=0.7
# PG_MEMORY=640M
# REDIS_CPUS=0.3
# REDIS_MEMORY=160M
# REDIS_MAXMEMORY=96mb

# Postgres tuning. shared_buffers wants roughly a quarter of PG_MEMORY;
# effective_cache_size only ESTIMATES the OS page cache and allocates nothing,
# but setting it above what the machine actually has makes the planner pick
# index scans that then hit disk.
#
# On a 4-vCPU / 8GB host these are reasonable:
#   PG_SHARED_BUFFERS=384MB
#   PG_EFFECTIVE_CACHE=1GB
#   PG_WORK_MEM=8MB
#   PG_MAX_CONNECTIONS=100
#
# Defaults (1 vCPU / 2GB):
# PG_SHARED_BUFFERS=160MB
# PG_EFFECTIVE_CACHE=384MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_MAX_CONNECTIONS=50
