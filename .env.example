# FinCalc 2.0 API — copy to .env and fill in.
# .env is gitignored. In production this file is sops+age encrypted as
# .env.prod.enc and decrypted only on the VPS at deploy time (docs 10 §9.3).

NODE_ENV=development
LOG_LEVEL=debug

# ── Ports ────────────────────────────────────────────────────────────────────
# BLOCKED on the VPS (already in use by other projects):
#   5432, 5433, 3050, 3000, 5050, 6379, 5678
# config.ts rejects these at boot rather than letting a collision happen silently.
PORT=8087

# ── Datastores ───────────────────────────────────────────────────────────────
# Host ports 5442 / 6389 map to the containers' standard 5432 / 6379.
DATABASE_URL=postgresql://fincalc_owner:fincalc_dev_only@localhost:5442/fincalc?schema=public
REDIS_URL=redis://localhost:6389

POSTGRES_PASSWORD=fincalc_dev_only

# ── Currency rates (docs 18) ─────────────────────────────────────────────────
# SERVER-SIDE ONLY. This key must never appear in the Flutter app or the APK.
#
# The key currently hardcoded at app/lib/assets/currency_service.dart:7 is
# COMPROMISED — it ships inside every published APK and takes about two minutes
# to extract. Rotate it at exchangerate-api.com and put the NEW key here.
# Deleting the constant from the app does not undo that: it remains in git
# history and on every phone that already has the app installed.
EXCHANGERATE_API_KEY=

FX_BASE_CURRENCY=INR
# Freshness window in minutes. One upstream call per window, at most, and only
# when a user actually asks — a quiet night costs nothing.
FX_FRESH_MINUTES=60

# ── HTTP ─────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=256kb
