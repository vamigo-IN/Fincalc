  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncRev                  BigInt    @default(0) @map("sync_rev")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCalculation SavedCalculation?  @relation(fields: [sourceCalculationId], references: [id], onDelete: SetNull)
  contributions     GoalContribution[]
  linkedAssets      Asset[]
  emergencyFunds    EmergencyFund[]
  calendarEvents    CalendarEvent[]

  @@index([userId, priority, id], map: "ix_goals__user_live")
