  status              UserStatus @default(active)
  failedLoginCount    Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  /// Reserved. The erasure that ships (05 §9.3) hard-deletes the row, so this is never set. See 05 R2.
  anonymisedAt        DateTime? @map("anonymised_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile        UserProfile?
  devices        UserDevice[]
  refreshTokens  RefreshToken[]
  goals          Goal[]
  goalContributions GoalContribution[]
  expenseCategories ExpenseCategory[]
  budgets        Budget[]
