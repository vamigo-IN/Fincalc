}

model ReferenceRate {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rateKind  RateKind @map("rate_kind")
  code      String
  rate      Decimal  @db.Decimal(9, 6)
  asOf      DateTime @map("as_of") @db.Date
  source    String   @default("")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([rateKind, code, asOf], map: "ux_rr__kind_code_date")
  @@index([rateKind, code, asOf(sort: Desc)], map: "ix_rr__latest")
  @@map("reference_rates")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorType   AuditActorType @default(user) @map("actor_type")
  actorId     String?  @map("actor_id") @db.Uuid
  subjectHash Bytes?   @map("subject_hash")
  action      String
  entityTable String?  @map("entity_table")
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  ipPrefix    String?  @map("ip_prefix") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectHash, createdAt(sort: Desc)], map: "ix_audit__subject_time")
  @@index([entityTable, entityId, createdAt(sort: Desc)], map: "ix_audit__entity")
  @@index([action, createdAt(sort: Desc)], map: "ix_audit__action_time")
  @@map("audit_log")
}
