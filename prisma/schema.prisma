model ExpenseCategory {
  id           String    @id @db.Uuid
  userId       String?   @map("user_id") @db.Uuid   // NULL = system seed (05 L4 exception)
  categoryKey  String    @map("category_key")
  name         String
  kind         CategoryKind @default(discretionary)
  iconKey      String    @default("category") @map("icon_key")
  colorHex     String    @default("#607D8B") @map("color_hex") @db.Char(7)
  sortOrder    Int       @default(500) @map("sort_order") @db.SmallInt
  parentId     String?   @map("parent_id") @db.Uuid
  // `is_system` is DELIBERATELY ABSENT from this model.
  //
  // It is a Postgres generated column, GENERATED ALWAYS AS (user_id IS NULL)
  // STORED, created by migration 0004. Prisma cannot express that: `@default`
  // makes Prisma SUPPLY the value rather than omit it, and Postgres then rejects
  // the insert with "cannot insert a non-DEFAULT value into a generated column".
  //
  // Nothing is lost — the value is derivable as `userId === null` in TypeScript.
  // The column exists so the partial unique indexes and SQL-side queries can use
  // it. Prisma ignores unknown columns, so this is safe.
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncRev      BigInt    @default(0) @map("sync_rev")

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ExpenseCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ExpenseCategory[] @relation("CategoryTree")
  budgetCategories BudgetCategory[]
  transactions     Transaction[]

  @@index([userId, sortOrder], map: "ix_expense_categories__user_sort")
  @@index([userId, syncRev], map: "ix_expense_categories__user_sync")
  @@map("expense_categories")
}

