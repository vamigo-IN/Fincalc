  expectedReturnRateMicro  Int       @default(120000) @map("expected_return_rate_micro")
  monthlyContributionPaise BigInt    @default(0) @map("monthly_contribution_paise")
  status                   GoalStatus @default(active)
  sourceCalculationId      String?   @map("source_calculation_id") @db.Uuid
