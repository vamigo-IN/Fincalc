  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncRev     BigInt    @default(0) @map("sync_rev")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  article LearningArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, syncRev], map: "ix_lp__user_sync")
  @@map("learning_progress")
}

model SavedCalculation {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  calculatorKey  String    @map("calculator_key")
  label          String?
  inputs         Json
  outputs        Json
  engineVersion  String    @map("engine_version")
  rulesetVersion String?   @map("ruleset_version")
  isPinned       Boolean   @default(false) @map("is_pinned")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncRev        BigInt    @default(0) @map("sync_rev")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]
  loans Loan[]

  @@index([userId, createdAt(sort: Desc)], map: "ix_sc__user_recent")
  @@index([userId, calculatorKey, createdAt(sort: Desc)], map: "ix_sc__user_kind")
  @@index([userId, syncRev], map: "ix_sc__user_sync")
  @@map("saved_calculations")
}

model Report {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  reportType    ReportType @map("report_type")
  status        ReportStatus @default(queued)
  periodStart   DateTime? @map("period_start") @db.Date
  periodEnd     DateTime? @map("period_end") @db.Date
  params        Json      @default("{}")
  payload       Json?
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts ReportArtifact[]

  @@index([userId, requestedAt(sort: Desc)], map: "ix_reports__user_recent")
  @@index([status, requestedAt], map: "ix_reports__queue")
  @@map("reports")
}

model ReportArtifact {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  kind        ArtifactKind @default(pdf)
  storagePath String   @map("storage_path")
  byteSize    Int      @map("byte_size")
  sha256      Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId], map: "ix_ra__report")
  @@map("report_artifacts")
}

model Subscription {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  platform           SubscriptionPlatform @default(google_play)
  productId          String    @map("product_id")
  purchaseToken      String?   @unique(map: "ux_subs__purchase_token") @map("purchase_token")
  orderId            String?   @map("order_id")
  status             SubscriptionStatus @default(pending_verification)
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  autoRenewing       Boolean   @default(true) @map("auto_renewing")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  lastVerifiedAt     DateTime? @map("last_verified_at") @db.Timestamptz(6)
  rawNotification    Json      @default("{}") @map("raw_notification")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlements Entitlement[]

  @@index([userId, status], map: "ix_subs__user_status")
  @@index([currentPeriodEnd], map: "ix_subs__expiring")
  @@map("subscriptions")
}

model Entitlement {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  featureKey     String    @map("feature_key")
  source         EntitlementSource @default(subscription)
  subscriptionId String?   @map("subscription_id") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

model FeatureFlag {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  flagKey     String   @unique(map: "ux_ff__key") @map("flag_key")
  description String   @default("")
  isEnabled   Boolean  @default(false) @map("is_enabled")
  rolloutPct  Int      @default(0) @map("rollout_pct") @db.SmallInt
  targetRule  Json     @default("{}") @map("target_rule")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model TaxRuleset {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fyLabel       String    @map("fy_label")
  rulesetKey    String    @unique(map: "ux_tr__key") @map("ruleset_key")
  status        RulesetStatus @default(draft)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  schemaVersion Int       @default(1) @map("schema_version")
  ruleset       Json
  checksum      Bytes
  sourceNote    String    @default("") @map("source_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
