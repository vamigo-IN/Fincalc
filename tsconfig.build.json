{
  "extends": "./tsconfig.json",
  // NO SCRIPT IN THE RUNTIME IMAGE CAN TOUCH AN ADMIN CREDENTIAL.
  //
  // reset-admin.ts was compiled in here so it could be run with
  // `docker compose exec`. It is gone: shell access to the container should not
  // be a way to mint or reset the account that reads every user's finances.
  // Password changes happen at /admin/account, signed in, with the current
  // password; the first admin on a fresh database is one-time SQL (DEPLOY.md).
  //
  // generate-signing-key.ts is a pure key generator that touches no account and
  // no database, so it stays. emit-golden-vectors.ts is excluded as a dev tool
  // that reads test fixtures.
  "include": [
    "src/**/*.ts",
    "prisma/seed.ts",
    "scripts/generate-signing-key.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    ".scratch",
    "scripts/emit-golden-vectors.ts"
  ]
}
